+  Future<SkinningData> D3D9Rtx::gta4eProcessVSSkinning(const RasterGeometry& geoData) {
+    ScopedCpuProfileZone();
+    // GTA IV (RAGE) skinning VS: float3x4 bone matrices at c[base + 3*i .. +2], p'_k = dot(row_k, float4(p, 1)),
+    // then the world matrix (D3DTS_WORLD, set by the compatibility mod). Remix's skinning path expects
+    // world-space bones (like D3D9 fixed-function WORLDMATRIX(n)), so bone_i = World * B_i.
+    const uint32_t base = RtxOptions::Gta4e::vsSkinningBoneBase();
+    const auto& consts = d3d9State().vsConsts.fConsts;
+    const uint32_t regCount = static_cast<uint32_t>(std::size(consts));
+    uint32_t maxBones = std::min<uint32_t>(RtxOptions::Gta4e::vsSkinningMaxBones(), 256u);
+    if (base >= regCount) {
+      maxBones = 0;
+    } else {
+      maxBones = std::min<uint32_t>(maxBones, (regCount - base) / 3);
+    }
+
+    const Matrix4 world = d3d9State().transforms[GetTransformIndex(D3DTS_WORLD)];
+    std::array<Matrix4, 256> bones;
+    for (uint32_t b = 0; b < maxBones; ++b) {
+      const Vector4& r0 = consts[base + b * 3 + 0];
+      const Vector4& r1 = consts[base + b * 3 + 1];
+      const Vector4& r2 = consts[base + b * 3 + 2];
+      Matrix4 m;
+      m[0] = Vector4(r0.x, r1.x, r2.x, 0.f);
+      m[1] = Vector4(r0.y, r1.y, r2.y, 0.f);
+      m[2] = Vector4(r0.z, r1.z, r2.z, 0.f);
+      m[3] = Vector4(r0.w, r1.w, r2.w, 1.f);
+      bones[b] = world * m;
+    }
+    const Matrix4* const boneMatrices = maxBones ? m_stagedBones.stageBones(bones.data(), maxBones) : nullptr;
+
+    HashQuery blendIndices;
+    {
+      auto& buffer = geoData.blendIndicesBuffer;
+      blendIndices.pBase = (uint8_t*) buffer.mapPtr(buffer.offsetFromSlice());
+      blendIndices.elementSize = imageFormatInfo(buffer.vertexFormat())->elementSize;
+      blendIndices.stride = buffer.stride();
+      blendIndices.size = blendIndices.stride * geoData.vertexCount;
+      blendIndices.ref = buffer.buffer().ptr();
+      blendIndices.ref->acquire(DxvkAccess::Read);
+      blendIndices.ref->incRef();
+    }
+    const uint32_t numBonesPerVertex = 4;
+    const uint32_t vertexCount = geoData.vertexCount;
+
+    return m_pGeometryWorkers->Schedule([boneMatrices, blendIndices, numBonesPerVertex, vertexCount, maxBones]()->SkinningData {
+      ScopedCpuProfileZone();
+      int minBoneIndex = 0, maxBoneIndex = -1;
+      if (!getMinMaxBoneIndices(blendIndices.pBase, blendIndices.stride, vertexCount, numBonesPerVertex, minBoneIndex, maxBoneIndex)) {
+        minBoneIndex = 0; maxBoneIndex = 0;
+      }
+      blendIndices.ref->release(DxvkAccess::Read);
+      blendIndices.ref->decRef();
+
+      SkinningData skinningData;
+      const uint32_t numBones = std::min<uint32_t>(static_cast<uint32_t>(maxBoneIndex + 1), maxBones);
+      if (numBones == 0 || boneMatrices == nullptr) {
+        return skinningData;
+      }
+      skinningData.pBoneMatrices.assign(boneMatrices, boneMatrices + numBones);
+      skinningData.minBoneIndex = std::min<uint32_t>(static_cast<uint32_t>(minBoneIndex), numBones - 1);
+      skinningData.numBones = numBones;
+      skinningData.numBonesPerVertex = numBonesPerVertex;
+      skinningData.computeHash();
+      return skinningData;
+    });
+  }
