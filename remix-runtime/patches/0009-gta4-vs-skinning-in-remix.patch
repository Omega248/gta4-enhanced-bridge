+  bool D3D9Rtx::gta4eCanSkinVS(const RasterGeometry& geoData) const {
+    if (!RtxOptions::Gta4e::vsSkinning() || !m_parent->UseProgrammableVS()) {
+      return false;
+    }
+    if (!geoData.blendWeightBuffer.defined() || !geoData.blendIndicesBuffer.defined() || !geoData.normalBuffer.defined()) {
+      return false;
+    }
+    const VkFormat bw = geoData.blendWeightBuffer.vertexFormat();
+    const VkFormat pos = geoData.positionBuffer.vertexFormat();
+    const VkFormat nrm = geoData.normalBuffer.vertexFormat();
+    const VkFormat bi = geoData.blendIndicesBuffer.vertexFormat();
+    const bool bwOk = bw == VK_FORMAT_B8G8R8A8_UNORM || bw == VK_FORMAT_R8G8B8A8_UNORM;
+    const bool biOk = imageFormatInfo(bi)->elementSize == 4;
+    const bool posOk = pos == VK_FORMAT_R32G32B32_SFLOAT || pos == VK_FORMAT_R32G32B32A32_SFLOAT;
+    const bool nrmOk = nrm == VK_FORMAT_R32G32B32_SFLOAT || nrm == VK_FORMAT_R32G32B32A32_SFLOAT;
+    return bwOk && biOk && posOk && nrmOk && (geoData.blendWeightBuffer.offsetFromSlice() % 4) == 0;
+  }
