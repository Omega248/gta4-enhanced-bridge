 }
 #endif
 
+// gta4e: weight i of vertex, from float weights or packed UNORM8 weights
+float readBlendWeight(ReadBuffer(float) srcBlendWeight, uint baseWeightsOffset, uint i, ConstBuffer(SkinningArgs) cb) {
+  if (cb.weightsUnorm8 == 0) {
+    return srcBlendWeight[baseWeightsOffset + i];
+  }
+  const uint packed = asuint(srcBlendWeight[baseWeightsOffset]);
+  uint byteIndex = i;
+  if (cb.weightSwizzle == 0) {
+    // shader sees D3DCOLOR as (r,g,b,a) = bytes (2,1,0,3); indices via D3DCOLORtoUBYTE4 come out in memory order
+    byteIndex = (i == 0) ? 2u : (i == 1) ? 1u : (i == 2) ? 0u : 3u;
+  }
+  return float((packed >> (byteIndex * 8u)) & 0xffu) * (1.0f / 255.0f);
+}
