+    m_ctx->writeTimestamp(m_gpuBegin);
   }
 
   __ScopedAnnotation::~__ScopedAnnotation() {
+    Rc<DxvkGpuQuery> gpuEnd = m_ctx->getDevice()->createGpuQuery(VK_QUERY_TYPE_TIMESTAMP, 0, 0);
+    m_ctx->writeTimestamp(gpuEnd);
     m_ctx->endDebugLabel();
+
+    static const double nsPerTick = m_ctx->getDevice()->adapter()->deviceProperties().limits.timestampPeriod;
+    std::lock_guard<std::mutex> lock(g_gpuZoneMutex);
+    g_gpuZones.push_back({ gta4e::gpuSite(m_name), m_gpuBegin, gpuEnd, ++g_gpuZoneCounter });
+    if ((g_gpuZoneCounter & 31u) == 0u) {
+      drainGpuZones(nsPerTick);
+    }
   }
 
