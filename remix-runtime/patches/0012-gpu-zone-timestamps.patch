 namespace dxvk {
 
+  // gta4e: GPU time per ScopedGpuProfileZone from a pair of timestamp queries. Pairs are kept in
+  // submission order and drained (non-blocking) whenever a new zone ends; finished pairs are added to
+  // the zone profiler's GPU sites ("G" lines in rtx-remix/gta4e_profile.txt).
+  namespace {
+    struct PendingGpuZone {
+      gta4e::GpuSite* site;
+      Rc<DxvkGpuQuery> begin, end;
+      uint64_t pushedAt;  // zone-end counter when queued
+    };
+    std::mutex g_gpuZoneMutex;
+    std::vector<PendingGpuZone> g_gpuZones;
+    uint64_t g_gpuZoneCounter = 0;
+    constexpr uint64_t kGpuZoneMaxAge = 4096;  // zone ends (~40+ frames); older pairs are dropped
+
+    // Collects every finished pair, wherever it is in the list; runs every 32 zone ends.
+    void drainGpuZones(double nsPerTick) {
+      size_t keep = 0;
+      for (size_t i = 0; i < g_gpuZones.size(); ++i) {
+        auto& z = g_gpuZones[i];
+        DxvkQueryData a, b;
+        const auto sa = z.begin->getData(a);
+        const auto sb = z.end->getData(b);
+        const bool pending = sa == DxvkGpuQueryStatus::Pending || sb == DxvkGpuQueryStatus::Pending;
+        if (pending && g_gpuZoneCounter - z.pushedAt < kGpuZoneMaxAge) {
+          if (keep != i) g_gpuZones[keep] = std::move(z);
+          ++keep;
+          continue;
+        }
+        if (sa == DxvkGpuQueryStatus::Available && sb == DxvkGpuQueryStatus::Available
+         && b.timestamp.time >= a.timestamp.time) {
+          z.site->ns.fetch_add(uint64_t(double(b.timestamp.time - a.timestamp.time) * nsPerTick), std::memory_order_relaxed);
+          z.site->calls.fetch_add(1, std::memory_order_relaxed);
+        }
+      }
+      g_gpuZones.resize(keep);
+    }
+  }
+
