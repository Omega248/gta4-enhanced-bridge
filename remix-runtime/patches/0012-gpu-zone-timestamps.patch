 namespace dxvk {
 
+  // gta4e: GPU time per ScopedGpuProfileZone from a pair of timestamp queries. Pairs are kept in
+  // submission order and drained (non-blocking) whenever a new zone ends; finished pairs are added to
+  // the zone profiler's GPU sites ("G" lines in rtx-remix/gta4e_profile.txt).
+  namespace {
+    struct PendingGpuZone {
+      gta4e::GpuSite* site;
+      Rc<DxvkGpuQuery> begin, end;
+    };
+    std::mutex g_gpuZoneMutex;
+    std::deque<PendingGpuZone> g_gpuZones;
+    constexpr size_t kMaxPendingGpuZones = 16384;  // results normally arrive within a few frames
+
+    void drainGpuZones(double nsPerTick) {
+      while (!g_gpuZones.empty()) {
+        auto& z = g_gpuZones.front();
+        DxvkQueryData a, b;
+        const auto sa = z.begin->getData(a);
+        const auto sb = z.end->getData(b);
+        if (sa == DxvkGpuQueryStatus::Pending || sb == DxvkGpuQueryStatus::Pending) {
+          if (g_gpuZones.size() < kMaxPendingGpuZones) break;  // oldest still in flight: stop here
+        } else if (sa == DxvkGpuQueryStatus::Available && sb == DxvkGpuQueryStatus::Available
+                && b.timestamp.time >= a.timestamp.time) {
+          z.site->ns.fetch_add(uint64_t(double(b.timestamp.time - a.timestamp.time) * nsPerTick), std::memory_order_relaxed);
+          z.site->calls.fetch_add(1, std::memory_order_relaxed);
+        }
+        g_gpuZones.pop_front();  // available, failed, or dropped because the queue is full
+      }
+    }
+  }
+
