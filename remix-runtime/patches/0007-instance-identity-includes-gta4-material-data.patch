diff --git a/src/dxvk/rtx_render/rtx_draw_call_tracker.cpp b/src/dxvk/rtx_render/rtx_draw_call_tracker.cpp
index 8627f39..265e743 100644
--- a/src/dxvk/rtx_render/rtx_draw_call_tracker.cpp
+++ b/src/dxvk/rtx_render/rtx_draw_call_tracker.cpp
@@ -103,7 +103,13 @@ namespace dxvk {
     IdentityHashData data{};
 
     data.geoHash = drawCallState.getGeometryData().getHashForRule(rules::FullGeometryHash);
-    data.matHash = drawCallState.getMaterialData().getHash();
+    // gta4e: GTA IV submits some objects twice per frame with the same textures but different per-draw
+    // data (custom render states: modifiers, emissive, wetness...). Keying the instance only by the
+    // material hash made both submissions share one ReplacementInstance whose material identity flipped
+    // every draw, forcing the slow dynamic path for both. Fold the full legacy identity in so each
+    // submission keeps its own, stable instance.
+    data.matHash = drawCallState.getMaterialData().getHash() ^
+                   (drawCallState.getMaterialData().computeIdentityHash() * 0x9E3779B97F4A7C15ull);
     data.overrideMaterialHash = overrideMaterialData != nullptr
         ? overrideMaterialData->getHash()
         : kEmptyHash;
